{
  "name": "dmarques",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/finalize-headers.mjs",
    "sync": "astro sync",
    "check": "astro sync && astro check",
    "test": "node --test \"src/**/*.test.mjs\"",
    "format": "prettier --write \"**/*.astro\" && biome format --write .",
    "lint": "biome check .",
    "verify:gates": "node scripts/verify/aurora-gates.mjs",
    "verify:seo": "node scripts/verify/seo-gates.mjs",
    "verify:browser": "node scripts/verify/browser-gates.mjs",
    "verify:forms": "node scripts/verify/form-gates.mjs",
    "verify:form-height": "node scripts/verify/form-card-height.mjs",
    "verify:headers": "node scripts/verify/header-gates.mjs",
    "og:generate": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.14",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/analytics": "2.0.1",
    "astro": "7.3.8",
    "resend": "6.33.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "~0.9",
    "@biomejs/biome": "2.5.12",
    "@lhci/cli": "0.15.1",
    "playwright": "1.64.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
