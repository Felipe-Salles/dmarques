---
import { Picture } from 'astro:assets';
import founderPortrait from '../assets/founder-portrait-placeholder.webp';
---

<section id="sobre" class="about">
  <div class="about-grid">
    <div class="about-media" data-reveal="1">
      <div class="about-halo" aria-hidden="true"></div>
      <div class="about-frame">
        <Picture
          src={founderPortrait}
          alt="Felipe Salles, fundador da Dmarques"
          formats={['avif', 'webp']}
          width={480}
          height={600}
        />
      </div>
    </div>
    <div class="about-copy" data-reveal="1">
      <span class="about-eyebrow">Quem faz</span>
      <div class="about-heading-group">
        <h2>Felipe Salles</h2>
        <span class="about-subtitle">Desenvolvedor web · Fundador da Dmarques</span>
      </div>
      <p>
        Sou desenvolvedor web e cuido pessoalmente de cada projeto que entra na Dmarques. Trabalho
        com sites, sistemas sob medida e automações — da primeira conversa até o suporte depois da
        entrega.
      </p>
      <p>
        O que me interessa é problema de operação: entender onde o processo trava e construir a
        ferramenta certa para destravar. Menos pacote pronto, mais solução que serve para o seu
        caso.
      </p>
      <div class="about-social">
        <span class="about-social-mark" aria-hidden="true"></span>
        <a href="https://instagram.com/felipe.salles1" target="_blank" rel="noopener noreferrer"
          >@felipe.salles1</a
        >
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    z-index: var(--z-section);
    background: var(--color-bg);
    padding: var(--space-section) var(--space-gutter);
  }

  .about-grid {
    max-width: 1080px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(2.25rem, 5vw, 4rem);
    align-items: center;
  }

  .about-media {
    position: relative;
  }

  .about-halo {
    position: absolute;
    inset: -0.875rem;
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-3xl);
    pointer-events: none;
  }

  .about-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .about-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .about-eyebrow {
    font-family: var(--font-text);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-light);
  }

  .about-heading-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .about-heading-group h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: clamp(1.75rem, 3.4vw, 3.125rem);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-strong);
  }

  .about-subtitle {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .about-copy p {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .about-social {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }

  .about-social-mark {
    width: 24px;
    height: 1px;
    background: var(--color-accent-border);
  }

  .about-social a {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .about-social a:hover,
  .about-social a:focus-visible {
    color: var(--color-accent-light);
  }
</style>
