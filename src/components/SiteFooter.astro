---
import { Image } from 'astro:assets';
import logotipo from '../assets/brand/logotipo.png';
import simbolo from '../assets/brand/simbolo.png';

import { GENERIC_WA_TEXT, buildWaUrl } from '../lib/whatsapp.ts';

const prefix = Astro.url.pathname === '/' ? '' : '/';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="lockup" aria-label="Dmarques Desenvolvimento Web — página inicial">
          <Image src={simbolo} alt="" height={34} densities={[1, 2]} class="logo-symbol" />
          <Image src={logotipo} alt="" height={34} densities={[1, 2]} class="logo-type" />
        </a>
        <p>Sites, sistemas, soluções web e automações sob medida. Ibitinga · SP.</p>
      </div>
      <div class="foot-cols">
        <div>
          <h2 class="foot-title">Navegação</h2>
          <a href={`${prefix}#servicos`}>Serviços</a>
          <a href={`${prefix}#projetos`}>Projetos</a>
          <a href={`${prefix}#processo`}>Como trabalhamos</a>
          <a href={`${prefix}#sobre`}>Sobre</a>
          <a href={`${prefix}#contato`}>Pedir orçamento</a>
        </div>
        <div>
          <h2 class="foot-title">Contato</h2>
          <a href={buildWaUrl(GENERIC_WA_TEXT)} target="_blank" rel="noopener noreferrer">(16) 99611-1785</a>
          <a href="mailto:contato@agenciadmarques.com.br">contato@agenciadmarques.com.br</a>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} Dmarques Soluções Web</span>
      <a href="/politica-de-privacidade">Política de privacidade</a>
      <span>Ibitinga · SP</span>
    </div>
  </div>
</footer>

<a
  class="wa-float"
  href={buildWaUrl(GENERIC_WA_TEXT)}
  target="_blank"
  rel="noopener noreferrer"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="var(--color-ember)"
    stroke-width="1.8"
    aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-4.1-1.1z"></path></svg
  >
  WhatsApp
</a>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--color-border);
    padding: 56px 0 40px;
    background: var(--color-bg);
  }

  .foot-grid {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }

  .lockup :global(img) {
    display: block;
    width: auto;
    height: 34px;
  }

  .foot-brand p {
    margin: 8px 0 0;
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .foot-cols {
    display: flex;
    gap: var(--space-16);
    flex-wrap: wrap;
    font-size: var(--text-sm);
  }

  .foot-cols > div {
    display: flex;
    flex-direction: column;
  }

  .foot-title {
    margin: 0 0 6px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .foot-cols a,
  .foot-bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }

  .foot-cols a:hover,
  .foot-cols a:focus-visible,
  .foot-bottom a:hover,
  .foot-bottom a:focus-visible {
    color: var(--color-text);
  }

  .foot-bottom {
    margin-top: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .wa-float {
    display: none;
    position: sticky;
    bottom: 16px;
    z-index: 40;
    margin: -64px 16px 16px auto;
    width: max-content;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 18px 0 14px;
    border-radius: 999px;
    background: #f2f4f7;
    color: #070a14;
    font-weight: 600;
    font-size: var(--text-sm);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.7);
  }

  @container site (max-width: 900px) {
    .wa-float {
      display: inline-flex;
    }
  }

  @container site (max-width: 560px) {
    .foot-grid,
    .foot-cols {
      flex-direction: column;
      gap: 24px;
    }
  }
</style>
