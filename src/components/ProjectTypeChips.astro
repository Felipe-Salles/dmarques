---
import { PROJECT_TYPES } from '../content/project-types';
---

<fieldset class="field">
  <legend>Tipo de projeto <small>(opcional)</small></legend>
  <div class="chips">
    {
      PROJECT_TYPES.map((t) => (
        <label class="chip">
          <input type="radio" name="tipo-projeto" value={t.value} />
          <span>{t.label}</span>
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 8px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  legend small {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    opacity: 0;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--color-text);
    transition:
      border-color 0.15s,
      background-color 0.15s,
      color 0.15s,
      transform 0.12s var(--ease-out);
  }

  .chip:hover span {
    border-color: rgba(0, 200, 255, 0.5);
  }

  .chip input:checked + span {
    background: var(--color-text);
    color: #070a14;
    border-color: var(--color-text);
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--aurora-cyan);
    outline-offset: 3px;
  }

  .chip:active span {
    transform: scale(0.96);
  }
</style>
