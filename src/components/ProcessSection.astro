---
import { getProcess } from '../content';
import Words from './Words.astro';

const steps = await getProcess();
---

<section id="processo" class="section process" aria-labelledby="met-title">
  <div class="wrap">
    <div class="process-head">
      <h2 class="h2" id="met-title" data-r="words">
        <Words text="Método claro, do primeiro contato à entrega." />
      </h2>
      <p class="lead d200" data-r="fade">
        Quatro etapas, sempre nesta ordem. Você sabe o que está acontecendo e o que vem depois.
      </p>
    </div>
    <ol class="steps" data-r="steps">
      {
        steps.map((item, i) => (
          <li class={`step i${i}`}>
            <span class="knot">{item.data.numero}</span>
            <div>
              <h3>{item.data.titulo}</h3>
              <p>{item.data.descricao}</p>
              {i === 0 && <p class="here">Nada é cobrado antes de você aprovar o plano.</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding-top: clamp(88px, 12cqi, 144px);
    padding-bottom: 0;
  }

  .process-head {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 32px;
    align-items: end;
    margin-bottom: 56px;
  }

  .process-head h2,
  .process-head p {
    margin: 0;
  }

  .steps {
    --p: 1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--color-ember) 0%,
      var(--aurora-cyan) 22%,
      var(--aurora-blue) 85%,
      transparent 100%
    );
    transform: scaleX(var(--p));
    transform-origin: left;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 12px;
  }

  .knot {
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    border-radius: 50%;
    border: 1px solid rgba(0, 200, 255, 0.5);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text);
  }

  .step:first-child .knot {
    border-color: var(--color-ember);
    color: var(--color-ember);
  }

  .step h3 {
    margin: 12px 0 0;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .step p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .step p.here {
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-ember);
  }

  @container site (max-width: 900px) {
    .process-head {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 40px;
      align-items: start;
    }

    .steps {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 40px;
    }
  }

  @container site (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .steps::before {
      top: 0;
      bottom: 0;
      left: 21px;
      right: auto;
      width: 1px;
      height: auto;
      transform: scaleY(var(--p));
      transform-origin: top;
    }

    .step {
      flex-direction: row;
      gap: 20px;
    }

    .knot {
      flex: none;
    }

    .step h3 {
      margin: 8px 0 4px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-ready) .step .knot {
      border-color: var(--color-border-strong);
      background: var(--color-bg);
      color: var(--color-text-faint);
    }

    :global(html.js-ready) .step > div {
      transform: translateY(6px);
    }

    :global(html.js-ready) .step h3,
    :global(html.js-ready) .step p {
      color: var(--color-text-faint);
    }

    :global(html.js-ready) .step p.here {
      color: var(--color-ember);
    }

    :global(html.js-ready) .step,
    :global(html.js-ready) .step .knot,
    :global(html.js-ready) .step > div,
    :global(html.js-ready) .step h3,
    :global(html.js-ready) .step p {
      transition:
        color 0.6s var(--ease-out),
        transform 0.6s var(--ease-out),
        border-color 0.6s var(--ease-out);
    }

    :global(html.js-ready) .step.lit .knot {
      border-color: rgba(0, 200, 255, 0.5);
      color: var(--color-text);
    }

    :global(html.js-ready) .step.lit:first-child .knot {
      border-color: var(--color-ember);
      color: var(--color-ember);
    }

    :global(html.js-ready) .step.lit > div {
      transform: none;
    }

    :global(html.js-ready) .step.lit h3 {
      color: var(--color-text);
    }

    :global(html.js-ready) .step.lit p {
      color: var(--color-text-muted);
    }

    :global(html.js-ready) .step.lit p.here {
      color: var(--color-ember);
    }
  }
</style>
