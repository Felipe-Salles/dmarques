---
import { getServices } from '../content';
import Words from './Words.astro';

const services = await getServices();

type IconShape =
  | { tag: 'rect'; x: number; y: number; width: number; height: number; rx: number }
  | { tag: 'path'; d: string }
  | { tag: 'circle'; cx: number; cy: number; r: number };

const iconShapes: Record<(typeof services)[number]['data']['icon'], IconShape[]> = {
  sites: [
    { tag: 'rect', x: 3.5, y: 5.5, width: 25, height: 21, rx: 3 },
    { tag: 'path', d: 'M3.5 11.5h25' },
    { tag: 'circle', cx: 7.6, cy: 8.5, r: 0.9 },
    { tag: 'circle', cx: 10.8, cy: 8.5, r: 0.9 },
    { tag: 'path', d: 'M9 17h9M9 21.5h14' },
  ],
  sistemas: [
    { tag: 'rect', x: 3.5, y: 4.5, width: 25, height: 23, rx: 3 },
    { tag: 'path', d: 'M12 4.5v23M3.5 13h8.5M20 13h8.5M20 20h8.5' },
  ],
  'solucoes-web': [
    { tag: 'path', d: 'M4 7h4l3 13h13l3-9H10' },
    { tag: 'circle', cx: 13, cy: 25, r: 1.8 },
    { tag: 'circle', cx: 23, cy: 25, r: 1.8 },
  ],
  automacoes: [
    { tag: 'circle', cx: 8, cy: 8, r: 3.2 },
    { tag: 'circle', cx: 24, cy: 16, r: 3.2 },
    { tag: 'circle', cx: 8, cy: 24, r: 3.2 },
    { tag: 'path', d: 'M11 9.6l10 4.8M11 22.4l10-4.8' },
  ],
};

---

<section id="servicos" class="section services" aria-labelledby="svc-title">
  <div class="wrap">
    <div class="services-wrap">
      <div class="services-intro">
        <h2 class="h2" id="svc-title" data-r="words">
          <Words text="Do site à automação, sob medida." />
        </h2>
        <p class="lead d200" data-r="fade">
          Cada projeto começa pelo seu processo, não por um pacote pronto. Nós desenhamos,
          desenvolvemos e acompanhamos o que o seu negócio realmente precisa.
        </p>
      </div>
      <ul class="svc-list" data-r="svc">
        {
          services.map((item, i) => (
            <li class={`svc i${i}`}>
              <svg
                aria-hidden="true"
                viewBox="0 0 32 32"
                fill="none"
                stroke-width="1.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {iconShapes[item.data.icon].map((shape) =>
                  shape.tag === 'rect' ? (
                    <rect
                      pathLength="1"
                      x={shape.x}
                      y={shape.y}
                      width={shape.width}
                      height={shape.height}
                      rx={shape.rx}
                    />
                  ) : shape.tag === 'circle' ? (
                    <circle pathLength="1" cx={shape.cx} cy={shape.cy} r={shape.r} />
                  ) : (
                    <path pathLength="1" d={shape.d} />
                  ),
                )}
              </svg>
              <h3>{item.data.titulo}</h3>
              <p>{item.data.descricao}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services {
    padding-top: clamp(88px, 12cqi, 144px);
    padding-bottom: clamp(56px, 8cqi, 96px);
  }

  .services-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6cqi, 96px);
    align-items: start;
  }

  .services-intro {
    position: sticky;
    top: calc(68px + 32px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .services-intro h2,
  .services-intro p {
    margin: 0;
  }

  .svc-list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-list::before,
  .svc::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
    transform-origin: left;
  }

  .svc-list::before {
    top: 0;
  }

  .svc {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 6px 20px;
    padding: 28px 0;
  }

  .svc::after {
    bottom: 0;
  }

  .svc svg {
    grid-row: 1 / span 2;
    width: 44px;
    height: 44px;
    stroke: var(--aurora-cyan);
  }

  .svc h3 {
    margin: 0;
    font-size: clamp(1.3rem, 2.4cqi, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .svc p {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 56ch;
  }

  .svc h3,
  .svc p,
  .svc svg {
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .svc:hover h3,
  .svc:hover p,
  .svc:hover svg,
  .svc:focus-within h3,
  .svc:focus-within p,
  .svc:focus-within svg {
    transform: translateX(10px);
  }

  @container site (max-width: 900px) {
    .services-wrap {
      grid-template-columns: 1fr;
    }

    .services-intro {
      position: static;
    }
  }

  @container site (max-width: 560px) {
    .svc {
      grid-template-columns: 36px 1fr;
      padding: 22px 0;
    }

    .svc svg {
      width: 26px;
      height: 26px;
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-ready) .svc-list::before,
    :global(html.js-ready) .svc::after {
      transform: scaleX(0);
    }

    :global(html.js-ready) .svc h3,
    :global(html.js-ready) .svc p {
      opacity: 0;
      translate: 0 12px;
    }

    :global(html.js-ready) .svc svg :global(*) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(html.js-ready) .svc-list.in::before,
    :global(html.js-ready) .svc-list.in .svc::after {
      transform: scaleX(1);
      transition: transform 1.1s var(--ease-out);
      transition-delay: calc(var(--i, 0) * 110ms);
    }

    :global(html.js-ready) .svc-list.in .svc h3,
    :global(html.js-ready) .svc-list.in .svc p {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 0.8s var(--ease-out),
        translate 0.8s var(--ease-out),
        transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      transition-delay: calc(var(--i) * 110ms);
    }

    :global(html.js-ready) .svc-list.in .svc p {
      transition-delay: calc(var(--i) * 110ms + 200ms), calc(var(--i) * 110ms + 200ms), 0s;
    }

    :global(html.js-ready) .svc-list.in .svc svg :global(*) {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.4s var(--ease-out);
      transition-delay: calc(var(--i) * 110ms);
    }
  }
</style>
