---
import { getServices } from '../content';

const services = await getServices();

type IconShape =
  | { tag: 'rect'; x: number; y: number; width: number; height: number; rx: number }
  | { tag: 'path'; d: string }
  | { tag: 'circle'; cx: number; cy: number; r: number };

const iconShapes: Record<(typeof services)[number]['data']['icon'], IconShape[]> = {
  sites: [
    { tag: 'rect', x: 3.5, y: 5.5, width: 25, height: 21, rx: 3 },
    { tag: 'path', d: 'M3.5 11.5h25' },
    { tag: 'circle', cx: 7.6, cy: 8.5, r: 0.9 },
    { tag: 'circle', cx: 10.8, cy: 8.5, r: 0.9 },
    { tag: 'path', d: 'M9 17h9M9 21.5h14' },
  ],
  sistemas: [
    { tag: 'rect', x: 3.5, y: 4.5, width: 25, height: 23, rx: 3 },
    { tag: 'path', d: 'M12 4.5v23M3.5 13h8.5M20 13h8.5M20 20h8.5' },
  ],
  'solucoes-web': [
    { tag: 'path', d: 'M4 7h4l3 13h13l3-9H10' },
    { tag: 'circle', cx: 13, cy: 25, r: 1.8 },
    { tag: 'circle', cx: 23, cy: 25, r: 1.8 },
  ],
  automacoes: [
    { tag: 'circle', cx: 8, cy: 8, r: 3.2 },
    { tag: 'circle', cx: 24, cy: 16, r: 3.2 },
    { tag: 'circle', cx: 8, cy: 24, r: 3.2 },
    { tag: 'path', d: 'M11 9.6l10 4.8M11 22.4l10-4.8' },
  ],
};

const lastOrder = Math.max(...services.map((item) => item.data.order));
---

<section id="servicos" class="services">
  <div class="services-inner">
    <div class="services-intro" data-reveal="1">
      <span class="services-eyebrow">O que fazemos</span>
      <h2>Tecnologia sob medida, <span>do site à automação</span></h2>
    </div>
    <div class="services-grid">
      {
        services.map((item) => (
          <article
            class:list={['services-card', { 'services-card-accent': item.data.order === lastOrder }]}
            data-reveal="1"
          >
            <svg
              aria-hidden="true"
              width="30"
              height="30"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {iconShapes[item.data.icon].map((shape) =>
                shape.tag === 'rect' ? (
                  <rect x={shape.x} y={shape.y} width={shape.width} height={shape.height} rx={shape.rx} />
                ) : shape.tag === 'circle' ? (
                  <circle cx={shape.cx} cy={shape.cy} r={shape.r} />
                ) : (
                  <path d={shape.d} />
                )
              )}
            </svg>
            <div class="services-card-copy">
              <h3>{item.data.titulo}</h3>
              <p>{item.data.descricao}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    z-index: var(--z-section);
    background: var(--color-bg);
    padding: var(--space-section) var(--space-gutter);
  }

  .services-inner {
    max-width: 1220px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.75rem, 5vw, 4rem);
  }

  .services-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .services-eyebrow {
    font-family: var(--font-text);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-light);
  }

  .services-intro h2 {
    margin: 0;
    max-width: 47.5rem;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: clamp(1.75rem, 3.4vw, 3.125rem);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-strong);
    text-wrap: balance;
  }

  .services-intro h2 span {
    color: var(--color-text-faint);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: clamp(1rem, 1.6vw, 1.375rem);
  }

  .services-card {
    padding: clamp(1.625rem, 2.4vw, 2.125rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--color-surface) 0%, rgba(255, 255, 255, 0.015) 100%);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    color: var(--color-accent);
    transition:
      border-color var(--dur-slow) var(--ease-standard),
      box-shadow var(--dur-slow) var(--ease-standard);
  }

  .services-card:hover,
  .services-card:focus-within {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-glow);
  }

  .services-card-accent {
    background: linear-gradient(180deg, var(--color-accent-surface) 0%, rgba(255, 255, 255, 0.015) 100%);
    border-color: var(--color-accent-border);
  }

  .services-card-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .services-card h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-lg);
    line-height: var(--leading-heading);
    letter-spacing: -0.01em;
    color: var(--color-text-strong);
  }

  .services-card p {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }
</style>
