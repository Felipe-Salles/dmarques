---
import { getServices } from '../content';
import { buildWaUrl, serviceWaText } from '../lib/whatsapp.ts';
import Words from './Words.astro';

const services = await getServices();

type IconShape =
  | { tag: 'rect'; x: number; y: number; width: number; height: number; rx: number }
  | { tag: 'path'; d: string }
  | { tag: 'circle'; cx: number; cy: number; r: number };

const iconShapes: Record<(typeof services)[number]['data']['icon'], IconShape[]> = {
  sites: [
    { tag: 'rect', x: 5, y: 9, width: 38, height: 28, rx: 4 },
    { tag: 'path', d: 'M5 16h38M17 43h14M24 37v6' },
  ],
  sistemas: [
    { tag: 'rect', x: 5, y: 7, width: 38, height: 34, rx: 4 },
    { tag: 'path', d: 'M5 15h38M15 15v26M21 23h16M21 29h12M21 35h14' },
  ],
  'solucoes-web': [
    { tag: 'circle', cx: 12, cy: 24, r: 6 },
    { tag: 'circle', cx: 36, cy: 12, r: 6 },
    { tag: 'circle', cx: 36, cy: 36, r: 6 },
    { tag: 'path', d: 'M17.5 21.5l13-7M17.5 26.5l13 7' },
  ],
  automacoes: [
    { tag: 'path', d: 'M8 14h20a6 6 0 010 12H20a6 6 0 000 12h20' },
    { tag: 'path', d: 'M36 34l4 4-4 4M12 10l-4 4 4 4' },
  ],
};
---

<section id="servicos" class="section services" aria-labelledby="svc-title">
  <div class="wrap">
    <div class="services-wrap">
      <div class="services-intro">
        <h2 class="h2" id="svc-title" data-r="words">
          <Words text="Do site à automação, sob medida." />
        </h2>
        <p class="lead d200" data-r="fade">
          Cada projeto começa pelo seu processo, não por um pacote pronto. Nós desenhamos,
          desenvolvemos e acompanhamos o que o seu negócio realmente precisa.
        </p>
      </div>
      <ul class="svc-list" data-r="line">
        {
          services.map((item, i) => (
            <li class={`svc i${i}`} data-r="svc">
              <svg aria-hidden="true" viewBox="0 0 48 48" fill="none" stroke-width="1.6">
                {iconShapes[item.data.icon].map((shape) =>
                  shape.tag === 'rect' ? (
                    <rect
                      pathLength="1"
                      x={shape.x}
                      y={shape.y}
                      width={shape.width}
                      height={shape.height}
                      rx={shape.rx}
                    />
                  ) : shape.tag === 'circle' ? (
                    <circle pathLength="1" cx={shape.cx} cy={shape.cy} r={shape.r} />
                  ) : (
                    <path pathLength="1" d={shape.d} />
                  ),
                )}
              </svg>
              <h3>{item.data.titulo}</h3>
              <p>{item.data.descricao}</p>
              <a
                class="svc-wa"
                href={buildWaUrl(serviceWaText(item.data.titulo))}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Falar sobre isso no WhatsApp — ${item.data.titulo}`}
              >
                Falar sobre isso no WhatsApp
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M7 17L17 7M9 7h8v8" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services {
    padding-top: clamp(88px, 12cqi, 144px);
    padding-bottom: 0;
  }

  .services-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6cqi, 96px);
    align-items: start;
  }

  .services-intro {
    position: sticky;
    top: calc(68px + 32px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .services-intro h2,
  .services-intro p {
    margin: 0;
  }

  .svc-list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-list::before,
  .svc::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
    transform-origin: left;
  }

  .svc-list::before {
    top: 0;
  }

  .svc {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 6px 20px;
    padding: 28px 0;
  }

  .svc::after {
    bottom: 0;
  }

  .svc > svg {
    grid-row: 1 / span 2;
    width: 30px;
    height: 30px;
    margin-top: 4px;
    stroke: var(--aurora-cyan);
  }

  .svc h3 {
    margin: 0;
    font-size: clamp(1.3rem, 2.4cqi, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.26;
  }

  .svc p {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  .svc-wa {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 6px;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-border);
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }

  .svc-wa svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s;
  }

  .svc-wa:hover,
  .svc-wa:focus-visible {
    color: var(--color-text);
    text-decoration-color: var(--aurora-cyan);
  }

  .svc-wa:hover svg,
  .svc-wa:focus-visible svg {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-wa:hover svg,
    .svc-wa:focus-visible svg {
      transform: none;
    }
  }

  .svc h3,
  .svc p,
  .svc > svg {
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .svc:hover h3,
  .svc:hover p,
  .svc:hover > svg,
  .svc:focus-within h3,
  .svc:focus-within p,
  .svc:focus-within > svg {
    transform: translateX(10px);
  }

  @container site (max-width: 900px) {
    .services-wrap {
      grid-template-columns: 1fr;
    }

    .services-intro {
      position: static;
    }
  }

  @container site (max-width: 560px) {
    .svc {
      grid-template-columns: 36px 1fr;
      padding: 22px 0;
    }

    .svc > svg {
      width: 26px;
      height: 26px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-ready) .svc-list::before,
    :global(html.js-ready) .svc::after {
      transform: scaleX(0);
    }

    :global(html.js-ready) .svc h3,
    :global(html.js-ready) .svc p {
      opacity: 0;
      translate: 0 12px;
    }

    :global(html.js-ready) .svc > svg :global(*) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(html.js-ready) .svc-list.in::before {
      transform: scaleX(1);
      transition: transform 1.1s var(--ease-out) 0ms;
    }

    :global(html.js-ready) .svc.in::after {
      transform: scaleX(1);
      transition: transform 1.1s var(--ease-out) calc(var(--i, 0) * 110ms);
    }

    :global(html.js-ready) .svc.in h3,
    :global(html.js-ready) .svc.in p {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 0.7s var(--ease-out),
        translate 0.8s var(--ease-out),
        transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      transition-delay: calc(var(--i, 0) * 110ms + 120ms), calc(var(--i, 0) * 110ms + 120ms), 0s;
    }

    :global(html.js-ready) .svc.in p {
      transition-delay: calc(var(--i, 0) * 110ms + 200ms), calc(var(--i, 0) * 110ms + 200ms), 0s;
    }

    :global(html.js-ready) .svc.in > svg :global(*) {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.4s var(--ease-out) calc(var(--i, 0) * 110ms);
    }
  }
</style>
