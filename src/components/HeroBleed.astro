---
import Aurora from './Aurora.astro';
import Words from './Words.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <Aurora variant="hero" />
  <div class="wrap">
    <div class="hero-copy">
      <h1 class="h-display hero-title" id="hero-title" aria-label="Onde ideias encontram a luz.">
        <span aria-hidden="true"
          ><Words text="Onde ideias encontram a luz." accentFrom={3} chars /></span
        >
      </h1>
      <p class="lead d520">
        Você traz a ideia; nós damos forma a ela — em site, sistema ou automação, rápido, seguro e
        feito para o seu processo. Fale direto com quem desenvolve.
      </p>
      <div class="hero-ctas d680">
        <a href="#contato" class="btn btn-primary">
          Pedir orçamento
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-ember)"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
        <a href="#projetos" class="btn btn-ghost">Ver projetos</a>
      </div>
    </div>

    <ul class="proof d820">
      <li class="i0">Nosso próprio site abre em <b>~1,5 s</b> no celular</li>
      <li class="i1">Nota <b>95+</b> no Google PageSpeed</li>
      <li class="i2"><b>Zero</b> cookies de rastreamento</li>
      <li class="i3">
        <a
          class="proof-link"
          href="https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fagenciadmarques.com.br%2F"
          target="_blank"
          rel="noopener noreferrer"
          >Confira você mesmo
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg
          ></a
        >
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(56px, 9cqi, 120px) 0 0;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }

  .h-display {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 6.4cqi, 4.6rem);
    line-height: 1.03;
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .proof {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 28px;
    max-width: 920px;
    margin: clamp(48px, 7cqi, 72px) auto 0;
    padding: 24px 0 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .proof::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-border-strong) 20%,
      var(--color-border-strong) 80%,
      transparent
    );
    transform-origin: center;
  }

  .proof b {
    color: var(--color-text);
    font-weight: 600;
  }

  .proof-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: rgba(0, 200, 255, 0.5);
    text-underline-offset: 5px;
  }

  .proof-link:hover,
  .proof-link:focus-visible {
    text-decoration-color: #00c8ff;
  }

  @container site (max-width: 560px) {
    .hero-ctas {
      width: 100%;
    }

    .hero-ctas .btn {
      flex: 1;
    }

    .proof {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px 18px;
      text-align: center;
      text-wrap: balance;
    }
  }

  .hero-title :global(.w) {
    overflow: visible;
  }

  .hero-title :global(.ch) {
    text-shadow: 0 0 calc(var(--g, 0) * 0.55em) rgba(120, 225, 255, calc(var(--g, 0) * 0.75));
  }

  .hero-title :global(.accent .ch) {
    text-shadow:
      0 0 0.5em rgba(0, 200, 255, 0.32),
      0 0 calc(var(--g, 0) * 0.6em) rgba(120, 225, 255, calc(var(--g, 0) * 0.8));
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-ready) .hero-title :global(.ch) {
      opacity: 0.1;
      filter: blur(7px);
    }

    :global(html.js-ready) .hero-title:global(.lit) :global(.ch) {
      opacity: 1;
      filter: blur(0);
      animation: ignite 1.4s var(--ease-out) backwards;
      animation-delay: var(--t, 0ms);
    }

    :global(html.js-ready) .hero-title:global(.lit) :global(.accent .ch) {
      animation-name: ignite-accent;
      animation-duration: 1.9s;
    }

    @keyframes ignite {
      0% {
        opacity: 0.1;
        filter: blur(7px);
        text-shadow: 0 0 0 rgba(120, 225, 255, 0);
      }

      32% {
        opacity: 1;
        filter: blur(0);
        color: #fff;
        text-shadow:
          0 0 0.3em rgba(190, 240, 255, 0.95),
          0 0 0.9em rgba(0, 200, 255, 0.6);
      }

      100% {
        opacity: 1;
        filter: blur(0);
        text-shadow: 0 0 0 rgba(120, 225, 255, 0);
      }
    }

    @keyframes ignite-accent {
      0% {
        opacity: 0.1;
        filter: blur(7px);
        text-shadow:
          0 0 0 rgba(0, 200, 255, 0),
          0 0 0 rgba(120, 225, 255, 0);
      }

      30% {
        opacity: 1;
        filter: blur(0);
        color: #e8fbff;
        text-shadow:
          0 0 0.35em rgba(200, 245, 255, 1),
          0 0 1.2em rgba(0, 200, 255, 0.85);
      }

      100% {
        opacity: 1;
        filter: blur(0);
        text-shadow:
          0 0 0.5em rgba(0, 200, 255, 0.32),
          0 0 0 rgba(120, 225, 255, 0);
      }
    }

    :global(html.js-ready) .hero .lead,
    :global(html.js-ready) .hero-ctas {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(4px);
    }

    :global(html.js-ready) .hero:global(.in) .lead,
    :global(html.js-ready) .hero:global(.in) .hero-ctas {
      opacity: 1;
      transform: none;
      filter: blur(0);
      transition:
        opacity 0.8s var(--ease-out),
        transform 0.9s var(--ease-out),
        filter 0.8s var(--ease-out);
      transition-delay: var(--d, 0ms);
    }

    :global(html.js-ready) .proof::before {
      transform: scaleX(0);
    }

    :global(html.js-ready) .hero:global(.in) .proof::before {
      transform: scaleX(1);
      transition: transform 1.2s var(--ease-out) var(--d, 0ms);
    }

    :global(html.js-ready) .proof > li {
      opacity: 0;
      transform: translateY(8px);
    }

    :global(html.js-ready) .hero:global(.in) .proof > li {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.7s var(--ease-out);
      transition-delay: calc(var(--d, 0ms) + 300ms + var(--i, 0) * 80ms);
    }
  }
</style>
