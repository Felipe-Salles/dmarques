---
import Aurora from './Aurora.astro';
import Words from './Words.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <Aurora variant="hero" />
  <div class="wrap">
    <div class="hero-copy">
      <h1 class="h-display hero-title" id="hero-title">
        <Words text="Software sob medida, com acabamento de produto." accentFrom={4} />
      </h1>
      <p class="lead d520">
        Sites, sistemas e automações desenhados para o seu processo — rápidos, seguros e prontos
        para crescer. Você fala direto com quem desenvolve.
      </p>
      <div class="hero-ctas d680">
        <a href="#contato" class="btn btn-primary">
          Pedir orçamento
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-ember)"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
        <a href="#projetos" class="btn btn-ghost">Ver projetos</a>
      </div>
    </div>

    <ul class="proof d820">
      <li class="i0">Nosso próprio site abre em <b>~1,5 s</b> no celular</li>
      <li class="i1">Nota <b>95+</b> no Google PageSpeed</li>
      <li class="i2"><b>Zero</b> cookies de rastreamento</li>
      <li class="i3">
        <a
          class="proof-link"
          href="https://pagespeed.web.dev/"
          target="_blank"
          rel="noopener noreferrer"
          >Confira você mesmo
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg
          ></a
        >
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(56px, 9cqi, 120px) 0 0;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }

  .h-display {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 6.4cqi, 4.6rem);
    line-height: 1.03;
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .proof {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 28px;
    max-width: 920px;
    margin: clamp(48px, 7cqi, 72px) auto 0;
    padding: 24px 0 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .proof::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
    transform-origin: center;
  }

  .proof b {
    color: var(--color-text);
    font-weight: 600;
  }

  .proof-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: rgba(0, 200, 255, 0.5);
    text-underline-offset: 5px;
  }

  .proof-link:hover,
  .proof-link:focus-visible {
    text-decoration-color: #00c8ff;
  }

  @container site (max-width: 560px) {
    .hero-ctas {
      width: 100%;
    }

    .hero-ctas .btn {
      flex: 1;
    }

    .proof {
      gap: 8px 18px;
    }
  }

  @keyframes proof-draw {
    from {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-ready) .hero-title :global(.w) > :global(span) {
      animation: word-in 0.9s var(--ease-out) both;
      animation-delay: calc(var(--i) * 55ms);
    }

    :global(html.js-ready) .hero .lead,
    :global(html.js-ready) .hero-ctas {
      animation: fade-in 0.8s var(--ease-out) both;
      animation-delay: var(--d);
    }

    :global(html.js-ready) .proof::before {
      animation: proof-draw 1.2s var(--ease-out) 820ms both;
    }

    :global(html.js-ready) .proof > li {
      animation: fade-in 0.8s var(--ease-out) both;
      animation-delay: calc(820ms + var(--i) * 80ms);
    }
  }
</style>
