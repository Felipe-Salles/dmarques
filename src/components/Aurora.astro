---
interface Props {
  variant: 'hero' | 'contact' | 'small';
}

const { variant } = Astro.props;
---

<div class:list={['aurora', `aurora--${variant}`]} aria-hidden="true"></div>

<style>
  .aurora {
    position: absolute;
    pointer-events: none;
    z-index: -1;
    left: -15%;
    right: -15%;
    top: -30%;
    height: 1100px;
    opacity: var(--aurora-opacity);
    background:
      radial-gradient(
        34% 38% at 30% 42%,
        rgba(0, 200, 255, 0.42),
        rgba(0, 200, 255, 0.14) 45%,
        transparent 72%
      ),
      radial-gradient(
        40% 46% at 70% 34%,
        rgba(58, 91, 255, 0.5),
        rgba(14, 30, 91, 0.32) 50%,
        transparent 74%
      ),
      radial-gradient(26% 30% at 50% 58%, rgba(14, 30, 91, 0.85), transparent 72%);
  }

  .aurora--contact {
    top: auto;
    bottom: -55%;
    height: 1000px;
    transform: scaleY(-1);
    opacity: calc(var(--aurora-opacity) * 0.8);
  }

  .aurora--small {
    height: 520px;
    top: -40%;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-ready) .aurora--hero {
      opacity: 0;
      transform: scale(0.94);
      will-change: transform;
    }

    :global(html.js-ready) .aurora--hero:global(.lit) {
      opacity: var(--aurora-opacity);
      transform: scale(1);
      transition:
        opacity 1.8s var(--ease-out),
        transform 2.4s var(--ease-out);
    }

    :global(html.js-ready) .aurora--hero:global(.lit):global(.drift) {
      animation: aurora-drift 22s var(--ease-in-out) 2.4s infinite alternate;
    }

    :global(html.js-ready) .aurora--hero:global(.paused) {
      animation-play-state: paused;
    }

    :global(html.js-ready) .aurora--hero:global(.lit):global(.gl) {
      opacity: calc(var(--aurora-opacity) * 0.5);
      transition: opacity 2.6s var(--ease-out);
    }

    :global(.aurora-gl) {
      position: absolute;
      pointer-events: none;
      z-index: -1;
      left: -15%;
      top: -30%;
      width: 130%;
      height: 1100px;
      display: block;
    }

    :global(html.js-ready) .aurora--contact {
      opacity: 0;
      transform: scaleY(-1) scale(0.94);
    }

    :global(html.js-ready) .aurora--contact:global(.lit) {
      opacity: calc(var(--aurora-opacity) * 0.8);
      transform: scaleY(-1);
      transition:
        opacity 1.8s var(--ease-out),
        transform 2.4s var(--ease-out);
    }
  }
</style>
