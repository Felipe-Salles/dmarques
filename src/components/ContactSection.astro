---
import Aurora from './Aurora.astro';
import { CHANNELS, CHANNEL_LABELS, DEFAULT_CHANNEL } from '../lib/form-schema.ts';
import { GENERIC_WA_TEXT, buildWaUrl } from '../lib/whatsapp.ts';
import ChipGroup from './ChipGroup.astro';
import ProjectTypeChips from './ProjectTypeChips.astro';
import Words from './Words.astro';

const channelOptions = CHANNELS.map((value) => ({ value, label: CHANNEL_LABELS[value] }));
const waUrl = buildWaUrl(GENERIC_WA_TEXT);
const waIcon = 'M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-4.1-1.1z';
---

<section id="contato" class="section contact" data-r="contact" aria-labelledby="ct-title">
  <Aurora variant="contact" />
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <h2 class="h2" id="ct-title" data-r="words">
        <Words text="Vamos construir algo sólido juntos." accentFrom={3} />
      </h2>
      <p class="lead d200" data-r="fade">
        Conte o que você precisa. Respondemos no mesmo dia útil, e quem responde é quem vai
        desenvolver.
      </p>
      <ol class="next d300" aria-label="O que acontece depois" data-r="list">
        <li class="i0"><span>1</span>Respondemos pelo WhatsApp no mesmo dia útil.</li>
        <li class="i1"><span>2</span>Fazemos o diagnóstico do problema e do processo atual.</li>
        <li class="i2"><span>3</span>Você recebe a proposta com escopo e prazo fechados.</li>
      </ol>
      <div class="channels d520" data-r="list">
        <a
          class="channel wa i0"
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="ic">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
              ><path d="M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-4.1-1.1z"></path></svg
            >
          </span>
          <div><b>WhatsApp</b><span>(16) 99611-1785 · resposta mais rápida</span></div>
          <svg
            class="go"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg
          >
        </a>
        <a class="channel i1" href="mailto:contato@agenciadmarques.com.br">
          <span class="ic">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
              ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"
              ></path></svg
            >
          </span>
          <div><b>E-mail</b><span>contato@agenciadmarques.com.br</span></div>
          <svg
            class="go"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg
          >
        </a>
        <a
          class="channel i2"
          href="https://www.instagram.com/agenciadmarques"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="ic">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
              ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"
              ></circle><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor"></circle></svg
            >
          </span>
          <div><b>Instagram</b><span>@agenciadmarques</span></div>
          <svg
            class="go"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg
          >
        </a>
      </div>
    </div>

    <form
      class="form glass"
      id="form-orcamento"
      method="post"
      action="/api/orcamento"
      aria-labelledby="form-title"
      data-r="form"
    >
      <div class="form-body">
        <h3 id="form-title">Pedir orçamento</h3>
        <p class="sub">Leva menos de um minuto.</p>
        <div class="hp" aria-hidden="true">
          <label for="empresa-site">Site da empresa</label>
          <input
            id="empresa-site"
            name="empresa-site"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <input type="hidden" name="elapsed-ms" value="" />
        <div class="field">
          <label for="nome">Nome</label>
          <input
            id="nome"
            name="nome"
            type="text"
            autocomplete="name"
            maxlength="80"
            required
            placeholder="Como podemos te chamar?"
          />
          <span class="msg" id="erro-nome">Informe seu nome para sabermos com quem falamos.</span>
        </div>
        <ChipGroup
          legend="Prefiro contato por"
          name="canal"
          options={channelOptions}
          checked={DEFAULT_CHANNEL}
          inline
          class="canal"
        />
        <div class="field contato contato-wa">
          <label class="sr-only" for="whatsapp">WhatsApp</label>
          <input
            id="whatsapp"
            name="whatsapp"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            maxlength="20"
            placeholder="(16) 99999-9999"
          />
          <span class="msg" id="erro-whatsapp"
            >Informe seu WhatsApp com DDD, ex.: (16) 99611-1785.</span
          >
        </div>
        <div class="field contato contato-email">
          <label class="sr-only" for="email">E-mail</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            maxlength="120"
            placeholder="voce@empresa.com.br"
          />
          <span class="msg" id="erro-email"
            >Informe um e-mail completo, ex.: nome@empresa.com.br.</span
          >
        </div>
        <ProjectTypeChips />
        <div class="field">
          <label for="mensagem">Mensagem <small>(opcional)</small></label>
          <textarea
            id="mensagem"
            name="mensagem"
            maxlength="1000"
            placeholder="Conte em poucas linhas o que precisa."></textarea>
          <span class="msg" id="erro-mensagem"
            >A mensagem passou de 1000 caracteres. Resuma em poucas linhas.</span
          >
        </div>
        <div class="alert" id="form-erro" role="group" aria-labelledby="form-erro-t" hidden>
          <p class="alert-t" id="form-erro-t" tabindex="-1">Não conseguimos enviar agora.</p>
          <p>
            Seus dados continuam aqui. Tente de novo em instantes ou fale com a gente pelo WhatsApp.
          </p>
          <a
            class="btn btn-ghost alert-wa"
            id="form-erro-wa"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"><path d={waIcon}></path></svg
            >
            Chamar no WhatsApp
          </a>
        </div>
        <div class="alert" id="form-limite" role="group" aria-labelledby="form-limite-t" hidden>
          <p class="alert-t" id="form-limite-t" tabindex="-1">
            Recebemos muitos pedidos em pouco tempo.
          </p>
          <p>
            Para não perder o seu, fale com a gente direto pelo WhatsApp. Respondemos no mesmo dia
            útil.
          </p>
          <a
            class="btn btn-ghost alert-wa"
            id="form-limite-wa"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"><path d={waIcon}></path></svg
            >
            Chamar no WhatsApp
          </a>
        </div>
        <button class="btn btn-primary" type="submit">
          <span class="spinner" aria-hidden="true"></span>
          <span class="btn-label">Enviar pedido de orçamento</span>
        </button>
        <p class="legal">Usamos seus dados só para responder a este pedido.</p>
      </div>
      <div class="success">
        <span class="ok" aria-hidden="true">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5" pathLength="1"></path></svg
          >
        </span>
        <h3 tabindex="-1" id="ok-title">Pedido enviado.</h3>
        <p class="sub">Respondemos no mesmo dia útil pelo contato que você informou.</p>
        <a
          class="btn btn-ghost alert-wa"
          id="ok-wa"
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"><path d={waIcon}></path></svg
          >
          Falar agora no WhatsApp
        </a>
      </div>
      <p class="sr-only" aria-live="polite" id="form-status"></p>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(88px, 12cqi, 144px);
    padding-bottom: clamp(88px, 12cqi, 144px);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 5cqi, 72px);
    align-items: start;
  }

  .contact-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-copy h2,
  .contact-copy p {
    margin: 0;
  }

  .next {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .next li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 12px;
    align-items: start;
  }

  .next li span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text);
    padding-top: 1px;
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .channel:hover,
  .channel:focus-visible {
    border-color: rgba(0, 200, 255, 0.45);
    background: rgba(0, 200, 255, 0.04);
  }

  .channel .ic {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .channel.wa .ic {
    color: var(--color-ember);
    border-color: rgba(255, 106, 61, 0.45);
  }

  .channel div {
    line-height: 1.2;
  }

  .channel b {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .channel div span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .channel .go {
    margin-left: auto;
    color: var(--color-text-muted);
    width: 16px;
    height: 16px;
    flex: none;
    transition: transform 0.25s var(--ease-out);
  }

  .channel:hover .go,
  .channel:focus-visible .go {
    transform: translate(2px, -2px);
  }

  .glass {
    background: var(--color-surface);
    backdrop-filter: blur(var(--blur-glass)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(140%);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      var(--shadow-lg);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass {
      background: rgba(14, 20, 39, 0.94);
    }
  }

  .form {
    padding: clamp(22px, 3.4cqi, 34px);
  }

  .form-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.25;
    margin: 0;
    font-weight: 600;
  }

  .form .sub {
    margin: -10px 0 2px;
    line-height: 1.25;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .field label {
    line-height: 1.25;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .field label small {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .field input,
  .field textarea {
    background: rgba(7, 10, 20, 0.6);
    border: 1px solid var(--color-border-strong);
    border-radius: 12px;
    min-height: 48px;
    padding: 12px 14px;
    font-size: var(--text-base);
    color: var(--color-text);
    outline: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #8f98a8;
  }

  .field textarea {
    resize: vertical;
    min-height: 104px;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--aurora-cyan);
    box-shadow: 0 0 0 3px rgba(0, 200, 255, 0.18);
  }

  .field.err input,
  .field.err textarea,
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  .msg {
    display: none;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-danger-text);
  }

  .field.err .msg,
  .field input[aria-invalid='true'] ~ .msg,
  .field textarea[aria-invalid='true'] ~ .msg {
    display: block;
  }

  .form .btn-primary {
    width: 100%;
    min-height: 52px;
    font-size: var(--text-base);
  }

  .form .btn-primary[disabled] {
    opacity: 0.8;
    cursor: progress;
  }

  .spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(7, 10, 20, 0.25);
    border-top-color: #070a14;
    border-radius: 50%;
  }

  .form.sending .spinner {
    display: inline-block;
    animation: spin 0.7s linear infinite;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form:has(:global(input[name='canal'][value='whatsapp']:checked)) .contato-email,
  .form:has(:global(input[name='canal'][value='email']:checked)) .contato-wa {
    display: none;
  }

  .field input,
  .field textarea {
    scroll-margin-top: 96px;
  }

  .alert {
    display: grid;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid rgba(255, 106, 61, 0.45);
    background: rgba(255, 106, 61, 0.06);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .alert[hidden] {
    display: none;
  }

  .alert p {
    margin: 0;
  }

  .alert-t {
    font-weight: 600;
    color: var(--color-text);
  }

  .alert-wa {
    min-height: 44px;
  }

  .alert-wa svg {
    color: var(--color-ember);
  }

  @container site (max-width: 560px) {
    .alert-wa {
      width: 100%;
    }
  }

  .legal {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .success {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .success .sub {
    margin: 0;
  }

  .success .ok {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(61, 220, 151, 0.12);
    color: var(--color-success);
    border: 1px solid rgba(61, 220, 151, 0.35);
  }

  .success .ok path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .form.done .form-body {
    display: none;
  }

  .form.done .success {
    display: flex;
  }

  .form.done .success path {
    animation: draw 0.5s 0.15s var(--ease-out) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .success .ok path {
      stroke-dashoffset: 0;
    }

    .form.done .success path {
      animation: none;
    }
  }

  @container site (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-ready) .next[data-r] > li,
    :global(html.js-ready) .channels[data-r] > .channel {
      opacity: 0;
      transform: translateY(14px);
    }

    :global(html.js-ready) .next.in > li {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.7s var(--ease-out),
        transform 0.8s var(--ease-out);
      transition-delay: calc(var(--d, 0ms) + var(--i, 0) * 90ms);
    }

    :global(html.js-ready) .channels.in > .channel {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.7s var(--ease-out),
        transform 0.8s var(--ease-out),
        border-color 0.2s,
        background-color 0.2s;
      transition-delay:
        calc(var(--d, 0ms) + var(--i, 0) * 90ms), calc(var(--d, 0ms) + var(--i, 0) * 90ms), 0s, 0s;
    }

    :global(html.js-ready) .form[data-r] {
      opacity: 0;
      transform: translateY(24px);
    }

    :global(html.js-ready) .form[data-r].in {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.9s var(--ease-out) 0.15s,
        transform 1s var(--ease-out) 0.15s;
    }
  }
</style>
