---
import { PROJECT_TYPES } from '../content/project-types';
---

<section id="contato" class="contact">
  <div class="contact-glow" aria-hidden="true"></div>
  <div class="contact-inner">
    <div class="contact-text" data-reveal="1">
      <span class="contact-eyebrow">Orçamento</span>
      <h2 class="contact-heading">Vamos falar sobre o <span>seu projeto</span></h2>
      <ul class="contact-benefits">
        <li>
          <svg
            class="contact-check"
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 12.5l5 5L20 6.5"></path>
          </svg>
          <span>Conversa sem compromisso</span>
        </li>
        <li>
          <svg
            class="contact-check"
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 12.5l5 5L20 6.5"></path>
          </svg>
          <span>Proposta clara, com escopo e prazo</span>
        </li>
        <li>
          <svg
            class="contact-check"
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 12.5l5 5L20 6.5"></path>
          </svg>
          <span>Início rápido</span>
        </li>
      </ul>
      <div class="contact-reach">
        <a
          href="https://wa.me/5516996111785"
          class="contact-phone"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            aria-hidden="true"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.5 11.6a8.4 8.4 0 0 1-12.3 7.4L4 20.2l1.3-4.1a8.4 8.4 0 1 1 15.2-4.5Z"
            ></path>
            <path d="M9.2 9.1c.4 1.5 1.4 3.1 2.7 4.1 1 .8 2 1.2 2.8 1.4"></path>
          </svg>
          (16) 99611-1785
        </a>
        <span class="contact-meta">felipe.salles1@hotmail.com · Ibitinga, SP</span>
      </div>
    </div>

    <form class="contact-form-card" data-reveal="1">
      <div class="contact-form-header">
        <h3>Pedir orçamento</h3>
        <span class="contact-form-helper">Resposta no mesmo dia útil.</span>
      </div>

      <label class="contact-field" for="nome">
        <span class="contact-label">Nome</span>
        <input type="text" id="nome" name="nome" placeholder="Como podemos te chamar" required />
      </label>

      <label class="contact-field" for="whatsapp">
        <span class="contact-label">WhatsApp</span>
        <input
          type="tel"
          id="whatsapp"
          name="whatsapp"
          placeholder="(00) 00000-0000"
          aria-describedby="contato-nota-obrigatorio"
        />
      </label>

      <span id="contato-nota-obrigatorio" class="contact-form-note">
        Preencha ao menos um: WhatsApp ou e-mail.
      </span>

      <label class="contact-field" for="email">
        <span class="contact-label">E-mail</span>
        <input type="email" id="email" name="email" aria-describedby="contato-nota-obrigatorio" />
      </label>

      <label class="contact-field" for="tipo-projeto">
        <span class="contact-label">Tipo de projeto</span>
        <select id="tipo-projeto" name="tipo-projeto" required>
          {PROJECT_TYPES.map((tipo) => <option value={tipo.value}>{tipo.label}</option>)}
        </select>
      </label>

      <label class="contact-field" for="mensagem">
        <span class="contact-label">Mensagem</span>
        <textarea
          id="mensagem"
          name="mensagem"
          rows="4"
          placeholder="Conte um pouco sobre o seu projeto"></textarea>
      </label>

      <button type="submit" class="contact-submit">Enviar pedido de orçamento</button>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    z-index: var(--z-section);
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-blue) 100%);
    padding: var(--space-section) var(--space-gutter);
  }

  .contact-glow {
    position: absolute;
    top: 10%;
    left: 20%;
    width: min(900px, 110%);
    height: 600px;
    overflow: hidden;
    background: radial-gradient(circle, var(--color-accent-glow) 0%, transparent 62%);
    pointer-events: none;
    z-index: var(--z-glow);
  }

  .contact-inner {
    position: relative;
    max-width: 1160px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(2.25rem, 4vw, 3.75rem);
    align-items: center;
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-eyebrow {
    font-family: var(--font-text);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-light);
  }

  .contact-heading {
    margin: 0;
    max-width: 29rem;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: clamp(1.875rem, 3.4vw, 2.875rem);
    line-height: 1.06;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-strong);
    text-wrap: pretty;
  }

  .contact-heading span {
    color: var(--color-accent);
  }

  .contact-benefits {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-benefits li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .contact-benefits span {
    font-family: var(--font-text);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text);
  }

  .contact-check {
    flex: none;
    color: var(--color-accent);
  }

  .contact-reach {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .contact-phone {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-strong);
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      background-color var(--dur-fast) var(--ease-standard);
  }

  .contact-phone:hover,
  .contact-phone:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent-surface);
  }

  .contact-meta {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }

  .contact-form-card {
    position: relative;
    background: var(--color-light-bg-alt);
    border-radius: var(--radius-2xl);
    padding: clamp(1.625rem, 3vw, 2.375rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    box-shadow: var(--shadow-lg);
  }

  .contact-form-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-form-header h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
    letter-spacing: -0.015em;
    color: var(--color-light-text-strong);
  }

  .contact-form-helper {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-light-text-muted);
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-label {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-light-text-muted);
  }

  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    border: 1px solid var(--color-light-input-border);
    background: var(--color-light-surface);
    border-radius: var(--radius-md);
    padding: 0.875rem 0.9375rem;
    font-family: var(--font-text);
    font-size: var(--text-sm);
    color: var(--color-light-text-strong);
    outline: none;
    transition:
      box-shadow var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard);
  }

  .contact-field select {
    appearance: none;
  }

  .contact-field textarea {
    resize: vertical;
  }

  .contact-field input:focus-visible,
  .contact-field select:focus-visible,
  .contact-field textarea:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .contact-form-note {
    margin-top: calc(var(--space-2) * -1);
    font-family: var(--font-text);
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--color-light-text-muted);
  }

  .contact-submit {
    margin-top: var(--space-1);
    border: 0;
    cursor: pointer;
    padding: var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-light-text-strong);
    color: var(--color-text-on-accent);
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard);
  }

  .contact-submit:hover,
  .contact-submit:focus-visible {
    background: var(--color-accent-hover);
    box-shadow: var(--shadow-accent);
  }
</style>
