---
import Aurora from '../components/Aurora.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Política de Privacidade — Dmarques" description="Veja como a Dmarques cuida dos dados que você nos envia ao pedir um orçamento.">
  <main id="conteudo">
    <section class="intro">
      <Aurora variant="small" />
      <div class="wrap content-block">
        <h1 class="h2">Política de Privacidade</h1>
        <p class="lead">Esta página será publicada com o conteúdo completo no lançamento do formulário.</p>
        <div class="actions">
          <a href="/" class="btn btn-ghost">Voltar ao início</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    padding: clamp(56px, 9cqi, 120px) 0;
    text-align: center;
  }

  .content-block {
    max-width: 70ch;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  h1,
  p {
    margin: 0;
  }

  .content-block :global(a:not(.btn)) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--aurora-cyan);
    text-underline-offset: 4px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
</style>
