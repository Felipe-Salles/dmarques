---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main id="conteudo">
    <div class="stack" style="outline: 1px solid transparent">
      <h1>Dmarques — Soluções Web</h1>
      <p>
        Um visitante entende em segundos o que a Dmarques faz, confia na agência e pede um orçamento
        — com um site que carrega rápido e nunca sai do ar.
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  main {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--space-16) var(--space-gutter);
    text-align: center;
  }

  .stack {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  h1 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-strong);
    text-wrap: balance;
  }

  p {
    font-family: var(--font-text);
    font-weight: var(--font-weight-regular);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text);
    max-width: 34rem;
    margin: 0 auto;
    text-wrap: pretty;
  }
</style>
