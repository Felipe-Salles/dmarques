---
import Aurora from '../components/Aurora.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { GENERIC_WA_TEXT, buildWaUrl } from '../lib/whatsapp.ts';
---

<BaseLayout
  title="Pedido enviado — Dmarques"
  description="Recebemos o seu pedido de orçamento. Respondemos no mesmo dia útil."
  noindex
>
  <main id="conteudo">
    <section class="intro">
      <Aurora variant="small" />
      <div class="wrap content-block">
        <h1 class="h2">Pedido enviado.</h1>
        <p class="lead">
          Recebemos o seu pedido. Respondemos no mesmo dia útil, pelo contato que você informou.
        </p>
        <div class="actions">
          <a
            class="btn btn-primary"
            href={buildWaUrl(GENERIC_WA_TEXT)}
            target="_blank"
            rel="noopener noreferrer">Falar agora no WhatsApp</a
          >
          <a href="/" class="btn btn-ghost">Voltar ao início</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    padding: clamp(56px, 9cqi, 120px) 0;
    text-align: center;
  }

  .content-block {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  h1,
  p {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
</style>
